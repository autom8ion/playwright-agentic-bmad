{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": ["node"],
    "paths": {
      "@pages/*": ["./src/pages/*"],
      "@api/*": ["./src/api/*"],
      "@factories/*": ["./src/factories/*"],
      "@fixtures": ["./src/fixtures/index.ts"]
    }
  },
  "include": ["src", "tests", "playwright.config.ts"]
}
